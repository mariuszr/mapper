{
  "name": "mapper",
  "version": "0.1.1",
  "author": "Mariusz Rosinski <mr@wyomee.com>",
  "description": "Tiny object-to-object mapping helper with declarative schema.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "node src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format ."
  },
  "keywords": [
    "mapper",
    "mapping",
    "transform",
    "object",
    "schema"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.3.1"
  }
}
